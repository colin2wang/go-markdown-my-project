# Normalize line endings: everything git treats as text gets LF
* text=auto eol=lf

# Windows script files keep CRLF (PowerShell/cmd convention)
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.nsi text eol=crlf
*.nsh text eol=crlf

# Binary assets — never touch
*.png binary
*.ico binary
*.woff2 binary
*.nsis binary
